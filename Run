#!/bin/bash
# تشغيل البوت
# Usage:  ./Run
cd "$(cd "$(dirname "$0")" && pwd)" || exit 1

# TDLib — بتتفك مرة واحدة وقت الـ docker build، فلو موجودة خلاص
# لو مش موجودة (تشغيل مباشر من السيرفر) بنفكّها هنا
if [ ! -f ./tdlua.so ]; then
    if [ -f ./tdlua.zip ]; then
        echo "⇜ جاري فكّ مكتبة TDLib..."
        unzip -o tdlua.zip > /dev/null || {
            echo "✘ فشل فكّ tdlua.zip — تأكد إن unzip متسطب"
            exit 1
        }
    else
        echo "✘ مفيش tdlua.so ولا tdlua.zip — البوت مش هيقدر يشتغل"
        exit 1
    fi
fi

# Gold.lua بتقول لو التوكن ناقص وبتقفل
exec lua5.3 Gold.lua
